# Fastlane pipeline for HippoCal (Capacitor 8 / Angular).
#
# The web build (`npm run build`) and `npx cap sync` are run BEFORE fastlane in
# the CI workflow, so these lanes only handle the native build + store upload.
#
# Android secrets (env):  ANDROID_KEYSTORE_PATH, ANDROID_KEYSTORE_PASSWORD,
#                         ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD, SUPPLY_JSON_KEY
# iOS secrets (env):      ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT (base64 .p8)

default_platform(:android)

platform :android do
  desc "Build a signed AAB and upload it to Google Play (default track: internal)"
  lane :deploy do |options|
    track = options[:track] || "internal"

    # Check the Play credentials BEFORE building: the bundle takes ~3 minutes,
    # and a missing permission would otherwise only surface after that wait.
    validate_play_store_json_key(json_key: ENV["SUPPLY_JSON_KEY"])

    gradle(
      project_dir: "android",
      task: "bundle",
      build_type: "Release"
    )

    upload_to_play_store(
      track: track,
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      # Only publish straight to users on the production track; otherwise stage
      # as a draft/complete on the test track.
      release_status: track == "production" ? "completed" : "draft",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

platform :ios do
  desc "Build a signed IPA and upload it to TestFlight"
  #
  # Signing uses Xcode "cloud signing" (Xcode 13+): the distribution certificate
  # and provisioning profile are created/fetched through the App Store Connect
  # API key. That means no local certificates, no .p12 secrets and no match
  # repository -- which matters here because there is no local Mac to bootstrap
  # any of those on. The macOS CI runner is the only Mac involved.
  #
  # Required env: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH (.p8 written by CI),
  #               APPLE_TEAM_ID
  lane :beta do
    key_path = ENV["ASC_KEY_PATH"]
    team_id  = ENV["APPLE_TEAM_ID"]

    UI.user_error!("ASC_KEY_PATH is not set or the file is missing") unless key_path && File.exist?(key_path)
    UI.user_error!("APPLE_TEAM_ID is not set") if team_id.to_s.empty?

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: key_path
    )

    # xcodebuild needs the key by absolute path; a relative one is silently ignored.
    xcargs = [
      "-allowProvisioningUpdates",
      "-authenticationKeyID #{ENV['ASC_KEY_ID']}",
      "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}",
      "-authenticationKeyPath #{File.absolute_path(key_path)}",
      "CODE_SIGN_STYLE=Automatic",
      "DEVELOPMENT_TEAM=#{team_id}"
    ].join(" ")

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      xcargs: xcargs,
      export_team_id: team_id,
      export_options: { signingStyle: "automatic" }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
